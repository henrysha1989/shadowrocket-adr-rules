#!name=字节系去广告·路径级
#!desc=字节系 App（抖音/红果/番茄/皮皮虾…）共用的广告链路 —— 只拦 URL 路径，不含域名规则。需要 HTTPS 解密（MITM），安装前请读 module/README.md。
#!author=henrysha1989
#!homepage=https://github.com/henrysha1989/shadowrocket-adr-rules
# 动作分级（2026-10-09 第二次完善，参考可莉插件中心的做法）：
#   JSON 接口 → reject-dict（回 200 + {}，SDK 拿到空数据、不重试）
#   上报/日志 → reject-200（回 200 空体，SDK 认为已上报、不重试）
#   素材/安装包/视频 → reject（回 404，直接断）
#   图片 → reject-img（回 200 + 1 像素图，App 不会显示裂图）
# 域名级拦截仍然只在 bytedance-ad.list；本模块不含 [Rule]、不含 IP、不含关键字、不跑第三方 JS。

[URL Rewrite]
# —— 广告接口 / 上报链路 ——
^https?:\/\/.+\.pangolin-sdk-toutiao\.com\/api\/ad\/union\/sdk - reject-dict
^https?:\/\/.+\.snssdk\.com\/api\/ad\/ - reject-dict
^https?:\/\/.+\.amemv\.com\/api\/ad\/ - reject-dict
^https?:\/\/.+?\.snssdk\.com\/motor\/operation\/activity\/display\/config\/V2\/ - reject-dict
^https?:\/\/.+\.pstatp\.com\/bytecom\/resource\/track-log\/src\/ - reject-200
^https?:\/\/gurd\.snssdk\.com\/src\/server\/v3\/package - reject
# —— 广告素材 / 广告安装包 ——
^https?:\/\/.+\.(pglstatp-toutiao|pstatp)\.com\/(obj|img)\/ad-app-package\/ - reject
^https?:\/\/.+\.(pglstatp-toutiao|pstatp)\.com\/(obj|img)\/ad\/ - reject
^https?:\/\/.+\.(pglstatp-toutiao|pstatp)\.com\/obj\/ad-pattern\/renderer - reject
^https?:\/\/.+\.pstatp\.com\/obj\/mosaic-legacy\/.+\?from\=ad - reject
^http:\/\/.+\.byteimg\.com\/ad-app-package - reject
# —— 广告图 ——
^https?:\/\/.+\.(pglstatp-toutiao|pstatp)\.com\/(obj|img)\/web\.business\.image\/ - reject-img
^https?:\/\/.+\.byteimg\.com\/tos-cn-i-1yzifmftcy\/(.+)-jpeg\.jpeg - reject-img
^http:\/\/.+\.byteimg\.com\/web\.business\.image - reject-img
# —— 广告视频（"有画面有声音"那种；出问题先注释这两条）——
^https?:\/\/.+\.pglstatp-toutiao\.com\/.+\/toutiao\.mp4 - reject
^https?:\/\/.+\.snssdk\.com\/video\/play\/1\/toutiao\/.+\/mp4 - reject

[MITM]
hostname = %APPEND% *.pangolin-sdk-toutiao.com, *.pglstatp-toutiao.com, *.pstatp.com, *.byteimg.com, *.snssdk.com, *.amemv.com
